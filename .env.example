# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 등록돼 있고 CI 가 커밋 여부를 검사한다.
# 실제 값은 팀 내부 채널로만 공유한다. 레포·Issue·PR에 붙여넣지 않는다.

# ── MySQL (docker-compose.yml 에서 사용) ─────────────────────────
MYSQL_DATABASE=ieobom
MYSQL_USER=ieobom
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── 백엔드(apps/api) 가 읽는 값 ──────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/ieobom?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=ieobom
DB_PASSWORD=
SERVER_PORT=8080

# ── LLM ──────────────────────────────────────────────────────────
# OpenAI 를 쓴다. 키는 백엔드에서만 읽고 프론트로 내려보내지 않는다.
#
# 비워 두어도 애플리케이션은 뜨고 테스트도 전부 통과한다.
# 대신 AI 구조화(POST /api/handovers/{id}/cards)를 호출하면 503 으로 응답한다.
#
# BASE_URL 과 MODEL 은 생략하면 아래 기본값이 쓰인다.
# 다른 모델로 바꿀 때, temperature 를 받지 않는 모델(추론 계열)은 호출이 거부될 수 있다.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=60s

# ── 웹 푸시 VAPID (apps/api) ──────────────────────────────────
# npx web-push generate-vapid-keys 명령으로 생성한다.
# 비워 두어도 앱은 뜨고 로컬 푸시 알림 발송만 비활성화된다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ieobom.com

# ── 프론트엔드(apps/web) ─────────────────────────────────────────
# Vite 는 VITE_ 접두사가 붙은 값만 클라이언트로 노출한다.
# 여기에는 비밀키를 절대 두지 않는다. 브라우저 번들에 그대로 들어간다.
#
# 프론트와 API 는 같은 출처에 둔다. 개발은 vite.config.ts 의 /api 프록시가,
# 배포는 Caddy 가 같은 일을 한다. 그래서 이 값은 로컬도 배포도 비워 둔다.
# 비어 있으면 shared/api/client.ts 가 상대경로 /api 로 호출한다. 그게 의도한 동작이다.
#
# 절대 주소(http://localhost:8080 등)를 넣으면 프록시를 우회해 다른 출처로 나가고,
# 백엔드에 CORS 설정이 없으므로 브라우저가 막는다. (docs/development.md)
#
# 참고: Vite 는 이 루트 .env 를 읽지 않는다. envDir 기본값이 apps/web 이다.
VITE_API_BASE_URL=
