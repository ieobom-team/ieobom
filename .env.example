# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 등록돼 있고 CI 가 커밋 여부를 검사한다.
# 실제 값은 팀 내부 채널로만 공유한다. 레포·Issue·PR에 붙여넣지 않는다.

# ── MySQL (docker-compose.yml 에서 사용) ─────────────────────────
MYSQL_DATABASE=ieobom
MYSQL_USER=ieobom
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── 백엔드(apps/api) 가 읽는 값 ──────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/ieobom?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=ieobom
DB_PASSWORD=
SERVER_PORT=8080

# ── LLM ──────────────────────────────────────────────────────────
# 사용할 모델 제공자가 확정되면 키 이름을 맞춰 수정한다.
LLM_API_KEY=
LLM_MODEL=

# ── 프론트엔드(apps/web) ─────────────────────────────────────────
# Vite 는 VITE_ 접두사가 붙은 값만 클라이언트로 노출한다.
# 여기에는 비밀키를 절대 두지 않는다. 브라우저 번들에 그대로 들어간다.
VITE_API_BASE_URL=http://localhost:8080
