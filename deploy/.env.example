# 배포용 환경변수 **이름만** 적어 둔 파일이다. 값은 여기 채우지 않는다.
#
#   cp deploy/.env.example deploy/.env
#
# `deploy/.env` 는 커밋하지 않는다. Public 저장소다.
# 루트의 `.env.example`(로컬 개발용)과 다른 파일이다.

# 배포 도메인. Caddy 가 이 이름으로 인증서를 발급한다. (예: ieobom.duckdns.org)
SITE_ADDRESS=

# MySQL. DATABASE 와 USER 는 비우면 ieobom 이 기본값이다.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# AI 구조화. 키가 없으면 컨테이너가 뜨지 않는다.
LLM_API_KEY=
# 아래 둘은 비우면 기본값(OpenAI · gpt-4.1-mini)을 쓴다.
LLM_BASE_URL=
LLM_MODEL=

# 시설 하원 시각. 후속 업무 기한의 상한이 여기서 나온다. 비우면 18:00 이다.
FACILITY_DISMISSAL_TIME=

# 웹 푸시 VAPID (apps/api)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
